{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poema documentado de PoetisA",
  "type": "object",
  "required": [
    "id",
    "title",
    "author",
    "book",
    "text",
    "sourceUrl",
    "sourceLabel",
    "rightsBasis",
    "rightsUrl",
    "transcriptionNote",
    "note",
    "pdfUrl",
    "authorBirth",
    "authorDeath",
    "year",
    "themes",
    "keywords"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceLabel": {
      "type": "string",
      "minLength": 1
    },
    "rightsBasis": {
      "type": "string",
      "minLength": 1
    },
    "rightsUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    },
    "transcriptionNote": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "pdfUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    },
    "authorBirth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100
    },
    "authorDeath": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
